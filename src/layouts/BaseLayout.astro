---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Project management for Obsidian. Tables, Gantt, and kanban — your tasks stored as plain markdown in your vault.' } = Astro.props
// `build.format: 'file'` yields `.html` pathnames (root is `/index.html`);
// strip the extension — and `index` for the root — so the canonical matches the
// extensionless URL Workers static assets serves at 200 and the slash-less
// sitemap.
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/\/$/, '')
const canonical = new URL(canonicalPath, Astro.site)
const ogImage = new URL('/og.png', Astro.site)

// Sitewide entity: establishes the site and its author so search and AI
// systems can attribute pages to a single, consistent source.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Obsidian Project Manager',
  url: Astro.site!.href.replace(/\/$/, ''),
  description: 'Project management for Obsidian. Tables, Gantt, and kanban — your tasks stored as plain markdown in your vault.',
  inLanguage: 'en',
  publisher: {
    '@type': 'Person',
    name: 'Stepan Kropachev',
    url: 'https://github.com/StepanKropachev',
  },
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="IwF9DkqGROAQjbyQ0gymIZqbKSC-zjt2D8nPiiYmi6Q" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Obsidian Project Manager — Gantt, kanban and table views over markdown tasks" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} is:inline />
    <Analytics />
    <script is:inline>
      // Enable reveal styles before first paint so content only starts
      // hidden when JS is present to bring it back. No JS → fully visible.
      document.documentElement.classList.add('motion')
    </script>
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />

    <script>
      // Quiet scroll-reveal: flip .is-in as each element enters the
      // viewport, then stop observing it. A [data-reveal-stagger] block
      // cascades its children on a short timer instead of all at once.
      // Reduced-motion or no IO → reveal everything immediately.
      const reveal = (el: Element) => {
        if (el.hasAttribute('data-reveal-stagger')) {
          Array.from(el.children).forEach((child, i) => {
            window.setTimeout(() => child.classList.add('is-in'), i * 65)
          })
        } else {
          el.classList.add('is-in')
        }
      }
      const targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]')
      const wantsMotion = matchMedia('(prefers-reduced-motion: no-preference)').matches
      if (wantsMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            reveal(entry.target)
            io.unobserve(entry.target)
          }
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 })
        targets.forEach((el) => io.observe(el))
      } else {
        targets.forEach(reveal)
      }
    </script>
  </body>
</html>
