---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Project management for Obsidian. Tables, Gantt, and kanban — your tasks stored as plain markdown in your vault.' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Enable reveal styles before first paint so content only starts
      // hidden when JS is present to bring it back. No JS → fully visible.
      document.documentElement.classList.add('motion')
    </script>
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />

    <script>
      // Quiet scroll-reveal: flip .is-in as each element enters the
      // viewport, then stop observing it. A [data-reveal-stagger] block
      // cascades its children on a short timer instead of all at once.
      // Reduced-motion or no IO → reveal everything immediately.
      const reveal = (el: Element) => {
        if (el.hasAttribute('data-reveal-stagger')) {
          Array.from(el.children).forEach((child, i) => {
            window.setTimeout(() => child.classList.add('is-in'), i * 65)
          })
        } else {
          el.classList.add('is-in')
        }
      }
      const targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]')
      const wantsMotion = matchMedia('(prefers-reduced-motion: no-preference)').matches
      if (wantsMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            reveal(entry.target)
            io.unobserve(entry.target)
          }
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 })
        targets.forEach((el) => io.observe(el))
      } else {
        targets.forEach(reveal)
      }
    </script>
  </body>
</html>
