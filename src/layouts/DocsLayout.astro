---
import BaseLayout from './BaseLayout.astro'
import DocsSidebar from '../components/DocsSidebar.astro'
import { allDocItems } from '../lib/docs-nav'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  slug: string
  group?: string
  headings?: Heading[]
}

const { title, slug, group, headings = [] } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)

const idx = allDocItems.findIndex((d) => d.slug === slug)
const prev = idx > 0 ? allDocItems[idx - 1] : null
const next = idx >= 0 && idx < allDocItems.length - 1 ? allDocItems[idx + 1] : null
---

<BaseLayout title={`${title} — Obsidian Project Manager`}>
  <div class="docs-shell">
    <div class="docs-grid">
      <DocsSidebar currentSlug={slug} />
      <article class="doc-content">
        <nav class="doc-breadcrumb" aria-label="Breadcrumb">
          <a href={`${base}/docs`}>Docs</a>
          {group && (
            <Fragment>
              <span class="crumb-sep">/</span>
              <span class="crumb-current">{group}</span>
            </Fragment>
          )}
        </nav>
        <slot />
        <nav class="doc-pager">
          {prev ? (
            <a class="pager-link prev" href={`${base}/docs/${prev.slug}`}>
              <span class="pager-dir">Previous</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="pager-link next" href={`${base}/docs/${next.slug}`}>
              <span class="pager-dir">Next</span>
              <span class="pager-title">{next.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      </article>
      <aside class="doc-toc">
        {toc.length > 0 && (
          <div class="toc-inner">
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'toc-sub' : ''}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <script>
    // Scroll-spy: highlight the current section in the "On this page" list.
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.doc-toc a'))
    if (tocLinks.length) {
      const byId = new Map<string, HTMLAnchorElement>()
      for (const a of tocLinks) byId.set((a.getAttribute('href') || '').slice(1), a)
      const heads = Array.from(
        document.querySelectorAll<HTMLElement>('.doc-content h2[id], .doc-content h3[id]')
      ).filter((h) => byId.has(h.id))

      let active: string | null = null
      const setActive = (id: string | null) => {
        if (id === active) return
        if (active) byId.get(active)?.classList.remove('is-active')
        active = id
        if (id) byId.get(id)?.classList.add('is-active')
      }
      const onScroll = () => {
        let current = heads[0]?.id ?? null
        for (const h of heads) {
          if (h.getBoundingClientRect().top <= 120) current = h.id
          else break
        }
        setActive(current)
      }
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })
    }
  </script>
</BaseLayout>

<style is:global>
  .doc-content {
    color: var(--on-surface-variant);
    line-height: 1.7;
    max-width: 44rem;
    min-width: 0;
  }
  .doc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    color: var(--on-surface-muted);
  }
  .doc-breadcrumb a {
    color: var(--on-surface-variant);
  }
  .doc-breadcrumb a:hover {
    color: var(--on-surface);
  }
  .doc-breadcrumb .crumb-sep {
    color: var(--on-surface-muted);
  }
  .doc-breadcrumb .crumb-current {
    color: var(--on-surface);
  }
  .doc-content :is(h1, h2, h3, h4)[id] {
    scroll-margin-top: 6rem;
  }
  .doc-content h1 {
    font-size: 2.5rem;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: var(--on-surface);
  }
  .doc-content h2 {
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .doc-content h3 {
    font-size: 1.0625rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--on-surface);
    font-family: var(--font-body);
    font-weight: 600;
  }
  .doc-content h4 {
    font-size: 0.9375rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--on-surface);
  }
  .doc-content p {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
  }
  .doc-content ul, .doc-content ol {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
  }
  .doc-content li {
    margin-bottom: 0.4rem;
  }
  .doc-content li > ul, .doc-content li > ol {
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
  }
  .doc-content strong { color: var(--on-surface); font-weight: 600; }
  .doc-content blockquote {
    margin: 1.25rem 0;
    padding: 0.85rem 1.25rem;
    background: var(--surface-container-low);
    border-left: 2px solid var(--primary);
    border-radius: var(--radius-sm);
    color: var(--on-surface);
    font-size: 0.9375rem;
  }
  .doc-content blockquote p { margin: 0; font-size: inherit; }
  .doc-content blockquote p + p { margin-top: 0.5rem; }

  .doc-placeholder {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    background: var(--surface-container-low);
    border-radius: var(--radius-md);
    background-image: repeating-linear-gradient(135deg, transparent 0 8px, rgba(139, 113, 208, 0.08) 8px 16px);
  }
  .doc-placeholder-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary);
  }
  .doc-placeholder-desc {
    font-size: 0.875rem;
    color: var(--on-surface-variant);
    font-style: italic;
  }

  .doc-content img,
  .doc-content video {
    display: block;
    max-width: 100%;
    max-height: 32rem;
    width: auto;
    height: auto;
    margin: 1.5rem auto;
    border-radius: var(--radius-md);
    background: var(--surface-container-lowest);
    box-shadow: var(--shadow-ambient);
  }
  .doc-content figure {
    margin: 1.5rem 0;
  }
  .doc-content figure img,
  .doc-content figure video {
    margin: 0;
  }
  .doc-content figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--on-surface-variant);
    font-style: italic;
  }

  .doc-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.875rem;
    background: var(--surface-container-lowest);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .doc-content thead {
    background: var(--surface-container-low);
  }
  .doc-content th, .doc-content td {
    padding: 0.6rem 0.85rem;
    text-align: left;
    vertical-align: top;
  }
  .doc-content th {
    font-weight: 600;
    color: var(--on-surface);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .doc-content tbody tr + tr td {
    border-top: 1px solid var(--hairline);
  }
  .doc-content td { color: var(--on-surface); }

  .doc-content code {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
    background: var(--surface-container-low);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-xs);
  }
  .doc-content pre {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    background: var(--surface-container-lowest);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.55;
    box-shadow: var(--shadow-ambient);
  }
  .doc-content pre code {
    background: none;
    padding: 0;
  }

  .doc-content hr {
    border: none;
    height: 1px;
    background: var(--hairline);
    margin: 2.5rem 0;
  }

  .doc-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: var(--surface-container-low);
    border-radius: var(--radius-md);
    color: var(--on-surface);
  }
  .pager-link.next { align-items: flex-end; text-align: right; }
  .pager-link:hover { background: var(--surface-container-lowest); color: var(--on-surface); }
  .pager-dir {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--on-surface-variant);
    font-weight: 500;
  }
  .pager-title {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>

<style>
  .docs-shell {
    padding: 3rem 1.5rem 4rem;
    max-width: 84rem;
    margin: 0 auto;
  }
  .docs-grid {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 13rem;
    gap: 3rem;
    align-items: start;
  }
  .doc-toc {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    align-self: start;
  }
  .toc-title {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--on-surface-variant);
  }
  .doc-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .doc-toc li.toc-sub a {
    padding-left: 1.5rem;
    font-size: 0.75rem;
  }
  .doc-toc a {
    display: block;
    padding: 0.3rem 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--on-surface-muted);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .doc-toc a:hover {
    color: var(--on-surface);
  }
  .doc-toc a.is-active {
    color: var(--on-surface);
    border-left-color: var(--primary);
  }
  @media (max-width: 1180px) {
    .docs-grid {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
    .doc-toc {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .docs-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
