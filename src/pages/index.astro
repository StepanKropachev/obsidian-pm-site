---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import InteractiveGantt from '../components/InteractiveGantt.astro'
import tableShot from '../assets/screenshots/table.png'
import ganttShot from '../assets/screenshots/gantt.png'
import kanbanShot from '../assets/screenshots/kanban.png'
import tableCloseup from '../assets/screenshots/table-closeup.png'
import ganttCloseup from '../assets/screenshots/gantt-closeup.png'
import taskModal from '../assets/screenshots/task-modal.png'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const features = [
  { icon: 'tune', title: 'Custom fields', body: 'Typed fields per project — text, number, date, select, multi-select, person, checkbox, URL.' },
  { icon: 'bookmark', title: 'Saved views', body: 'Save filters, sorts, and view mode. Switch between them with a click.' },
  { icon: 'account_tree', title: 'Subtasks', body: 'Nest tasks to any depth. Parent progress rolls up from children.' },
  { icon: 'arrow_forward', title: 'Dependencies', body: 'Link blockers. Auto-schedule shifts dependents when predecessors move.' },
  { icon: 'timer', title: 'Time tracking', body: 'Start a timer on any task. Log manually. Review estimated vs actual.' },
  { icon: 'bolt', title: 'Quick add', body: 'Capture a task without leaving the keyboard. Inline-edit status, priority, due date.' },
  { icon: 'check_box', title: 'Bulk edit', body: 'Multi-select and update status, priority, dates, assignees, tags, or archive in one move.' },
  { icon: 'palette', title: 'Native feel', body: 'Looks at home in any Obsidian theme. Light or dark, your colors stay yours.' },
]

const principles = [
  { title: 'Your data stays in your vault.', body: 'Every task is a markdown file you own. No database. No proprietary format.' },
  { title: 'Works offline.', body: 'Plan, edit, and track without a network connection. Sync however you already do.' },
  { title: 'Keyboard first.', body: 'Quick add, inline edit, and modal shortcuts. Mouse optional.' },
  { title: 'Open source.', body: 'MIT licensed. Read the code, file issues, send a PR.' },
]

const installSteps = [
  { n: 1, body: 'Open Obsidian → Settings → Community plugins.' },
  { n: 2, body: 'Click Browse and search "Project Manager".' },
  { n: 3, body: 'Install, then enable.' },
  { n: 4, body: 'Click the new ribbon icon to open your first project.' },
]
---

<BaseLayout title="Obsidian Project Manager — Project management for Obsidian">
  <section class="hero">
    <div class="bg-mesh" aria-hidden="true"><span class="mesh-blob"></span></div>
    <div class="hero-grain bg-grain" aria-hidden="true"></div>
    <div class="container hero-inner">
      <h1 class="hero-title">
        Project management <span class="hero-em">in your Obsidian</span>
      </h1>
      <p class="hero-sub">
        Tables, Gantt, and kanban over tasks stored as plain markdown. No database. No lock-in. Just files you own in your Obsidian vault.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="https://community.obsidian.md/plugins/project-manager" rel="noopener">
          Install from Obsidian
          <span class="icon">arrow_forward</span>
        </a>
        <a class="btn btn-secondary" href="https://github.com/stepankropachev/obsidian-pm" rel="noopener">
          View on GitHub
        </a>
      </div>
    </div>
    <div class="container hero-mockup-wrap">
      <div class="hero-mockup">
        <div class="mockup-frame is-hero is-interactive hero-interactive">
          <InteractiveGantt />
        </div>
        <div class="mockup-frame is-hero hero-static">
          <Image src={ganttShot} alt="Gantt view of an Obsidian PM project" sizes="100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="pitch">
    <div class="container pitch-inner">
      <div class="pitch-grid">
        <h2 class="pitch-title">Every task is an .md file you own</h2>
        <p class="lede pitch-lede">
          Every task is a markdown file with YAML frontmatter. Open them in any editor, version them in git, sync them how you like. No database. No proprietary format. Just files you own.
        </p>
      </div>
    </div>
  </section>

  <section class="three-view">
    <div class="container">
      <div class="view-row">
        <div class="view-copy">
          <h3>Table</h3>
          <p>Filter, sort, and edit thousands of tasks at the speed of a spreadsheet. Inline-edit status, priority, due date, progress. Multi-select for bulk changes.</p>
          <a href={`${base}/docs/table-view`} class="link-arrow">Read the docs <span class="icon">arrow_forward</span></a>
        </div>
        <div class="view-mockup view-stage">
          <div class="mockup-frame"><Image src={tableShot} alt="Table view of an Obsidian PM project" sizes="(max-width: 720px) 100vw, 56vw" /></div>
          <div class="float-frag frag-wide"><Image src={tableCloseup} alt="Editing tasks inline in the table" sizes="(max-width: 720px) 0px, 36vw" /></div>
        </div>
      </div>

      <div class="view-row reverse">
        <div class="view-copy">
          <h3>Gantt</h3>
          <p>Plan timelines visually. Drag bars to reschedule, resize to change duration, switch granularity from day to quarter. Dependencies render as lines.</p>
          <a href={`${base}/docs/gantt-view`} class="link-arrow">Read the docs <span class="icon">arrow_forward</span></a>
        </div>
        <div class="view-mockup view-stage">
          <div class="mockup-frame"><Image src={ganttShot} alt="Gantt view of an Obsidian PM project" sizes="(max-width: 720px) 100vw, 56vw" /></div>
          <div class="float-frag frag-wide"><Image src={ganttCloseup} alt="Dependency bars on the gantt timeline" sizes="(max-width: 720px) 0px, 36vw" /></div>
        </div>
      </div>

      <div class="view-row">
        <div class="view-copy">
          <h3>Kanban</h3>
          <p>Move work across statuses with a single drag. Quick-add at the bottom of any column. Filters shared with the table.</p>
          <a href={`${base}/docs/kanban-view`} class="link-arrow">Read the docs <span class="icon">arrow_forward</span></a>
        </div>
        <div class="view-mockup view-stage">
          <div class="mockup-frame"><Image src={kanbanShot} alt="Kanban view of an Obsidian PM project" sizes="(max-width: 720px) 100vw, 56vw" /></div>
          <div class="float-frag frag-modal"><Image src={taskModal} alt="Task detail with custom fields and time tracking" sizes="(max-width: 720px) 0px, 20vw" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <header class="section-head">
        <h2>Everything you need to run a project</h2>
      </header>
      <div class="feature-grid">
        {features.map((f) => (
          <div class="card feature-card">
            <span class="icon feature-icon">{f.icon}</span>
            <h4>{f.title}</h4>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="principles">
    <div class="container">
      <header class="section-head">
        <h2>Built on principles</h2>
      </header>
      <div class="principle-grid">
        {principles.map((p) => (
          <div class="principle">
            <h4>{p.title}</h4>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="bg-mesh proof-mesh" aria-hidden="true"></div>
    <div class="container container-narrow proof-inner">
      <h2>Free, open source, MIT licensed</h2>
      <p class="lede">Star the repo. File an issue. Send a pull request.</p>
      <div class="proof-ctas">
        <a class="btn btn-primary" href="https://github.com/stepankropachev/obsidian-pm" rel="noopener">
          <span class="icon">star</span>
          Star on GitHub
        </a>
        <a class="btn btn-secondary" href={`${base}/docs/install`}>Read the docs</a>
      </div>
    </div>
  </section>

  <section class="install">
    <div class="container">
      <header class="section-head">
        <h2>Install in 30 seconds</h2>
      </header>
      <ol class="install-steps">
        {installSteps.map((s) => (
          <li class="card">
            <span class="step-n">{s.n}</span>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — relies on natural content height. The mockup is tall enough to
     extend below the fold on initial load (Linear pattern); scrolling
     reveals the rest. No flex/auto-margin tricks. */
  .hero {
    position: relative;
    background: var(--surface);
    padding: 6rem 0 7rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-title {
    max-width: 50rem;
  }
  .hero-em {
    color: #ffffff;
  }
  .hero-sub {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--on-surface-variant);
    letter-spacing: -0.01em;
  }
  .hero-ctas {
    margin-top: 2.25rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-mockup-wrap {
    position: relative;
    z-index: 2;
    margin-top: 4rem;
    margin-bottom: 0;
    padding-right: 0;
  }
  /* Soft Linear-style ambient halo under the interactive mockup */
  .hero-mockup-wrap::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6rem;
    transform: translateX(-50%);
    width: 64rem;
    height: 20rem;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(113, 112, 255, 0.11), transparent 70%),
      radial-gradient(40% 50% at 50% 30%, rgba(157, 122, 255, 0.065), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-mockup {
    max-width: 64rem;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  /* Hero shows the live interactive gantt on desktop, a static screenshot
     on mobile where drag interactions don't translate to touch. */
  .hero-static { display: none; }
  /* When the mockup is interactive, give it a deeper Linear-style shadow */
  .mockup-frame.is-interactive {
    box-shadow:
      0 50px 120px -28px rgba(0, 0, 0, 0.85),
      0 90px 180px -64px rgba(113, 112, 255, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  /* Pitch */
  .pitch {
    background: var(--surface);
    padding-top: 7rem;
    padding-bottom: 6rem;
    position: relative;
  }
  .pitch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1.5rem 5rem;
    align-items: end;
    margin-top: 1.25rem;
  }
  .pitch-title {
    font-size: 3.25rem;
    line-height: 1.05;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }
  .pitch-lede {
    margin-top: 0;
    max-width: 28rem;
  }
  .lede {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--on-surface-variant);
    letter-spacing: -0.005em;
  }

  /* Three-view */
  .three-view {
    background: var(--surface);
    padding: 5rem 0 7rem;
    position: relative;
  }
  .three-view::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .section-head {
    margin: 0 auto 4rem;
    max-width: 36rem;
    text-align: center;
  }
  .section-head h2 {
    margin-top: 0.75rem;
  }
  .view-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 4rem;
    align-items: center;
    margin-bottom: 6rem;
  }
  .view-row.reverse {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  }
  .view-row.reverse .view-copy { order: 2; }
  .view-row.reverse .view-mockup { order: 1; }
  .view-row:last-child { margin-bottom: 0; }
  .view-copy h3 {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.028em;
    color: var(--on-surface);
    margin-bottom: 1rem;
  }
  .view-copy p {
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 28rem;
    color: var(--on-surface-variant);
  }

  /* Linear-style layering: the main view sits framed, a tighter UI fragment
     floats over a corner and hangs into the gutter toward the copy. Depth
     comes from stacked shadows + a gradient rim, not a hard border. */
  .view-stage {
    position: relative;
    isolation: isolate;
  }
  .float-frag {
    position: absolute;
    z-index: 3;
    bottom: -2.25rem;
    left: -2.75rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-container-lowest);
    box-shadow:
      0 28px 64px -22px rgba(0, 0, 0, 0.6),
      0 44px 96px -48px rgba(113, 112, 255, 0.32);
  }
  /* Reverse rows put the mockup on the left, so hang the fragment off the right */
  .view-row.reverse .float-frag {
    left: auto;
    right: -2.75rem;
  }
  .float-frag img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }
  /* 1px gradient rim hugging the fragment's corners */
  .float-frag::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.06) 45%, rgba(255, 255, 255, 0.02) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }
  .frag-wide { width: 60%; }
  .frag-modal { width: 30%; bottom: -1.5rem; }

  /* Features */
  .features {
    background: var(--surface);
    padding: 7rem 0;
    position: relative;
  }
  .features::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .feature-card { padding: 1.5rem; }
  .feature-card .feature-icon {
    font-size: 1.25rem;
    color: var(--primary-bright);
    margin-bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: var(--primary-tint);
    box-shadow: inset 0 0 0 1px rgba(113, 112, 255, 0.18);
  }
  .feature-card h4 {
    margin-bottom: 0.5rem;
    color: var(--on-surface);
  }
  .feature-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--on-surface-variant);
  }
  @media (max-width: 960px) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .feature-grid { grid-template-columns: 1fr; }
  }

  /* Principles */
  .principles {
    background: var(--surface);
    padding: 7rem 0;
    position: relative;
  }
  .principles::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 4rem;
    max-width: 56rem;
    margin: 0 auto;
  }
  .principle h4 {
    color: var(--on-surface);
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .principle p {
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 28rem;
    color: var(--on-surface-variant);
  }
  @media (max-width: 720px) {
    .principle-grid { grid-template-columns: 1fr; }
  }

  /* Proof */
  .proof {
    position: relative;
    background: var(--surface);
    padding: 8rem 0;
    overflow: hidden;
    isolation: isolate;
  }
  .proof::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
    z-index: 2;
  }
  .proof-mesh::before {
    width: 50rem;
    height: 50rem;
    top: -25rem;
    right: auto;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.18;
  }
  .proof-mesh::after { display: none; }
  .proof-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    margin: 0 auto;
  }
  .proof-ctas {
    margin-top: 2.25rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Install */
  .install {
    background: var(--surface);
    padding: 7rem 0 9rem;
    position: relative;
  }
  .install::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .install-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .install-steps li {
    padding: 1.75rem 1.5rem 2rem;
  }
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--primary-tint);
    box-shadow: inset 0 0 0 1px rgba(113, 112, 255, 0.25);
    color: var(--primary-bright);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .install-steps p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--on-surface-variant);
  }
  @media (max-width: 960px) {
    .install-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .install-steps { grid-template-columns: 1fr; }
  }

  /* Responsive */
  @media (max-width: 960px) {
    .hero { padding-top: 4rem; }
    .hero-mockup { transform: none; }
  }
  @media (max-width: 720px) {
    .view-row, .view-row.reverse {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .view-row.reverse .view-copy { order: 1; }
    .view-row.reverse .view-mockup { order: 2; }
    .float-frag { display: none; }
    .hero-interactive { display: none; }
    .hero-static { display: block; }
    h1 { font-size: 2.75rem; }
    h2 { font-size: 1.875rem; }
    .hero-sub { font-size: 1rem; }
    .pitch { padding-top: 5rem; padding-bottom: 5rem; }
    .pitch-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .pitch-title { font-size: 2.25rem; }
    .features, .principles, .install, .proof, .three-view { padding: 4rem 0; }
  }
</style>
