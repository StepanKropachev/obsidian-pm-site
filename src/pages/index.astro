---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import InteractiveGantt from '../components/InteractiveGantt.astro'
import tableShot from '../assets/screenshots/table.png'
import ganttShot from '../assets/screenshots/gantt.png'
import kanbanShot from '../assets/screenshots/kanban.png'
import tableCloseup from '../assets/screenshots/table-closeup.png'
import ganttCloseup from '../assets/screenshots/gantt-closeup.png'
import taskModal from '../assets/screenshots/task-modal-detail.png'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const features = [
  { icon: 'tune', title: 'Custom fields', body: 'Typed fields per project — text, number, date, select, multi-select, person, checkbox, URL.' },
  { icon: 'bookmark', title: 'Saved views', body: 'Save filters, sorts, and view mode. Switch between them with a click.' },
  { icon: 'account_tree', title: 'Subtasks', body: 'Nest tasks to any depth. Parent progress rolls up from children.' },
  { icon: 'arrow_forward', title: 'Dependencies', body: 'Link blockers. Auto-schedule shifts dependents when predecessors move.' },
  { icon: 'timer', title: 'Time tracking', body: 'Start a timer on any task. Log manually. Review estimated vs actual.' },
  { icon: 'bolt', title: 'Quick add', body: 'Capture a task without leaving the keyboard. Inline-edit status, priority, due date.' },
  { icon: 'check_box', title: 'Bulk edit', body: 'Multi-select and update status, priority, dates, assignees, tags, or archive in one move.' },
  { icon: 'palette', title: 'Native feel', body: 'Looks at home in any Obsidian theme. Light or dark, your colors stay yours.' },
]

const principles = [
  { title: 'Your data stays in your vault.', body: 'Every task is a markdown file you own. No database. No proprietary format.' },
  { title: 'Works offline.', body: 'Plan, edit, and track without a network connection. Sync however you already do.' },
  { title: 'Keyboard first.', body: 'Quick add, inline edit, and modal shortcuts. Mouse optional.' },
  { title: 'Open source.', body: 'MIT licensed. Read the code, file issues, send a PR.' },
]

const installSteps = [
  { n: 1, body: 'Open Obsidian → Settings → Community plugins.' },
  { n: 2, body: 'Click Browse and search "Project Manager".' },
  { n: 3, body: 'Install, then enable.' },
  { n: 4, body: 'Click the new ribbon icon to open your first project.' },
]

const siteUrl = new URL(base, Astro.site).href
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Obsidian Project Manager',
  description: 'Project management inside Obsidian. Tables, Gantt charts, and kanban boards over tasks stored as plain markdown in your vault.',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows, macOS, Linux, Android, iOS',
  softwareRequirements: 'Obsidian 1.7.2 or later',
  url: siteUrl,
  downloadUrl: 'https://github.com/StepanKropachev/obsidian-pm',
  license: 'https://github.com/StepanKropachev/obsidian-pm/blob/main/LICENSE',
  author: {
    '@type': 'Person',
    name: 'Stepan Kropachev',
    url: 'https://github.com/StepanKropachev',
  },
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
  },
}
---

<BaseLayout title="Obsidian Project Manager — Gantt, kanban & tables in your vault">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  <section class="hero">
    <div class="bg-glow" aria-hidden="true"></div>
    <div class="hero-grain bg-grain" aria-hidden="true"></div>
    <div class="container-wide hero-inner">
      <h1 class="hero-title" data-reveal>
        Project management <span class="hero-em">in your Obsidian</span>
      </h1>
      <div class="hero-aside" data-reveal style="--reveal-delay: 90ms">
        <p class="hero-sub">
          Tables, Gantt, and kanban over tasks stored as plain markdown. No database. No lock-in. Just files you own in your Obsidian vault.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="https://community.obsidian.md/plugins/project-manager" rel="noopener" data-gc-event="cta-install">
            Install from Obsidian
            <span class="icon">arrow_forward</span>
          </a>
          <a class="btn btn-secondary" href="https://github.com/stepankropachev/obsidian-pm" rel="noopener" data-gc-event="hero-github">
            View on GitHub
          </a>
        </div>
      </div>
    </div>
    <div class="container-wide hero-stage" data-reveal style="--reveal-delay: 180ms">
      <div class="hero-mockup">
        <div class="mockup-frame is-hero is-interactive hero-interactive">
          <InteractiveGantt />
        </div>
        <div class="mockup-frame is-hero hero-static">
          <Image src={ganttShot} alt="Gantt chart timeline in the Obsidian Project Manager plugin, with task bars across a date axis" sizes="100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="pitch">
    <div class="container-wide pitch-inner">
      <h2 class="pitch-statement">
        <span class="pitch-lead">Every task is a file you own.</span> <span class="pitch-tail">Plain markdown, versioned in git, synced however you like. No database, no lock-in — just files that outlive any app.</span>
      </h2>
    </div>
  </section>

  <section class="views">
    <div class="view-block">
      <div class="container-wide view-head" data-reveal>
        <p class="eyebrow">Table</p>
        <h2>Work through tasks at spreadsheet speed</h2>
        <div class="view-head-copy">
          <p>Inline-edit status, priority, due date, and progress without opening a file. Filter and sort by any field, including your own. Multi-select for bulk changes across hundreds of tasks.</p>
          <a href={`${base}/docs/table-view`} class="link-arrow">Read the docs <span class="icon">arrow_forward</span></a>
        </div>
      </div>
      <div class="container-wide view-stage" data-reveal style="--reveal-delay: 90ms">
        <div class="stage-main fade-deep">
          <div class="mockup-frame"><Image src={tableShot} alt="Obsidian Project Manager table view listing tasks with status, priority, due date, and progress columns" sizes="(max-width: 720px) 100vw, 94vw" /></div>
        </div>
        <div class="float-frag frag-wide frag-left"><Image src={tableCloseup} alt="Close-up of inline-editing a task's fields directly in the table view" sizes="(max-width: 720px) 0px, 48vw" /></div>
      </div>
    </div>

    <div class="view-block">
      <div class="container-wide view-head" data-reveal>
        <p class="eyebrow">Gantt</p>
        <h2>Plan the timeline on a Gantt chart</h2>
        <div class="view-head-copy">
          <p>Drag bars to reschedule, resize to change duration, switch granularity from day to quarter. Dependencies render as lines, and auto-schedule shifts dependents when a predecessor moves.</p>
          <a href={`${base}/docs/gantt-view`} class="link-arrow">Read the docs <span class="icon">arrow_forward</span></a>
        </div>
      </div>
      <div class="container-wide view-stage" data-reveal style="--reveal-delay: 90ms">
        <div class="stage-main fade-deep">
          <div class="mockup-frame"><Image src={ganttShot} alt="Obsidian Gantt chart with task bars and dependency lines spanning a project timeline" sizes="(max-width: 720px) 100vw, 94vw" /></div>
        </div>
        <div class="float-frag frag-wide frag-right"><Image src={ganttCloseup} alt="Close-up of dependency lines linking task bars on the Gantt timeline" sizes="(max-width: 720px) 0px, 48vw" /></div>
      </div>
    </div>

    <div class="view-block">
      <div class="container-wide view-head" data-reveal>
        <p class="eyebrow">Kanban</p>
        <h2>Move work across a kanban board</h2>
        <div class="view-head-copy">
          <p>Cards grouped by status, quick-add at the bottom of any column. Filters and saved views carry over from the table, so every view shows the same work from a different angle.</p>
          <a href={`${base}/docs/kanban-view`} class="link-arrow">Read the docs <span class="icon">arrow_forward</span></a>
        </div>
      </div>
      <div class="container-wide view-stage" data-reveal style="--reveal-delay: 90ms">
        <div class="stage-main fade-deep">
          <div class="mockup-frame"><Image src={kanbanShot} alt="Obsidian Project Manager kanban board with task cards grouped into status columns" sizes="(max-width: 720px) 100vw, 94vw" /></div>
        </div>
        <div class="float-frag frag-modal frag-right"><Image src={taskModal} alt="Task detail modal showing custom fields and the time-tracking panel" sizes="(max-width: 720px) 0px, 24vw" /></div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container-wide">
      <header class="section-head" data-reveal>
        <h2>Everything you need to run a project</h2>
      </header>
      <div class="feature-grid" data-reveal-stagger>
        {features.map((f) => (
          <div class="card feature-card">
            <span class="icon feature-icon">{f.icon}</span>
            <h4>{f.title}</h4>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="principles">
    <div class="container-wide">
      <header class="section-head" data-reveal>
        <h2>Built on principles</h2>
      </header>
      <div class="principle-grid" data-reveal-stagger>
        {principles.map((p) => (
          <div class="principle">
            <h4>{p.title}</h4>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="bg-glow" aria-hidden="true"></div>
    <div class="container container-narrow proof-inner" data-reveal>
      <h2>Free, open source, MIT licensed</h2>
      <p class="lede">Star the repo. File an issue. Send a pull request.</p>
      <div class="proof-ctas">
        <a class="btn btn-primary" href="https://github.com/stepankropachev/obsidian-pm" rel="noopener" data-gc-event="cta-github-star">
          <span class="icon">star</span>
          Star on GitHub
        </a>
        <a class="btn btn-secondary" href={`${base}/docs/install`} data-gc-event="cta-read-docs">Read the docs</a>
      </div>
    </div>
  </section>

  <section class="install">
    <div class="container-wide">
      <header class="section-head" data-reveal>
        <h2>Install in 30 seconds</h2>
      </header>
      <ol class="install-steps" data-reveal-stagger>
        {installSteps.map((s) => (
          <li class="card">
            <span class="step-n">{s.n}</span>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — Linear pattern: split header (statement left, support right),
     then the app below at near full viewport width with a sharp lower
     edge — the glow behind and the contact shadow under it sell the
     depth, not a fade. */
  .hero {
    position: relative;
    background: var(--surface);
    padding: 7rem 0 4rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2.5rem 5rem;
    align-items: end;
  }
  .hero-title {
    font-size: clamp(2.75rem, 4.6vw, 4.25rem);
    max-width: 44rem;
    text-wrap: balance;
  }
  .hero-em {
    color: #ffffff;
  }
  .hero-sub {
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--on-surface-variant);
    letter-spacing: -0.01em;
  }
  .hero-ctas {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .hero-stage {
    position: relative;
    z-index: 2;
    margin-top: 5rem;
  }
  /* Faint pool of light directly under the app — the only glow in the hero */
  .hero-stage::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -4rem;
    transform: translateX(-50%);
    width: min(85vw, 80rem);
    height: 24rem;
    background: radial-gradient(55% 60% at 50% 20%, rgba(177, 173, 255, 0.09), transparent 70%);
    filter: blur(48px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-mockup {
    position: relative;
    z-index: 2;
  }
  /* Hero shows the live interactive gantt on desktop, a static screenshot
     on mobile where drag interactions don't translate to touch. */
  .hero-static { display: none; }
  .mockup-frame.is-interactive {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 10px 28px -10px rgba(0, 0, 0, 0.8),
      0 50px 120px -28px rgba(0, 0, 0, 0.85),
      0 90px 180px -64px rgba(113, 112, 255, 0.22);
  }

  /* Pitch */
  .pitch {
    background: var(--surface);
    padding-top: 6rem;
    padding-bottom: 6rem;
    position: relative;
  }
  .pitch-statement {
    max-width: 64rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.5rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--on-surface-variant);
    text-wrap: pretty;
  }
  .pitch-lead {
    color: var(--on-surface);
  }
  .pitch-word {
    color: var(--pitch-dim, #44474d);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .pitch-word {
        animation: pitch-brighten linear both;
        animation-timeline: view();
      }
    }
  }
  @keyframes pitch-brighten {
    to { color: var(--on-surface-variant); }
  }
  @supports not (animation-timeline: view()) {
    .pitch-word { color: var(--on-surface-variant); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pitch-word { color: var(--on-surface-variant); }
  }
  .lede {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--on-surface-variant);
    letter-spacing: -0.005em;
  }

  /* Views — each block is a full-width stage. Heading and copy share a
     split header; the screenshot below takes the whole stage width and
     dissolves into the dark page at the bottom, with a crisp closeup
     fragment floating over the faded zone. */
  .views {
    background: var(--surface);
    padding: 5rem 0 3rem;
    position: relative;
  }
  .views::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .view-block {
    padding: 3rem 0 4rem;
  }
  /* Linear pattern: view name as a small eyebrow over a statement
     headline, support copy top-aligned in the right column */
  .view-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas:
      'eyebrow eyebrow'
      'title copy';
    gap: 0 6rem;
    align-items: start;
    margin-bottom: 3.5rem;
  }
  .view-head .eyebrow {
    grid-area: eyebrow;
    margin-bottom: 1.5rem;
  }
  .view-head h2 {
    grid-area: title;
    font-size: clamp(2.25rem, 3.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.034em;
    max-width: 17ch;
    text-wrap: balance;
  }
  .view-head-copy {
    grid-area: copy;
    padding-top: 0.4rem;
  }
  .view-head-copy p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--on-surface-variant);
    max-width: 34rem;
    margin-bottom: 1.25rem;
  }
  .view-stage {
    position: relative;
    isolation: isolate;
  }
  .stage-main {
    position: relative;
    z-index: 1;
  }
  .float-frag {
    position: absolute;
    z-index: 3;
    bottom: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-container-lowest);
    box-shadow:
      0 32px 80px -24px rgba(0, 0, 0, 0.75),
      0 52px 120px -56px rgba(113, 112, 255, 0.28);
  }
  .float-frag img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }
  /* 1px gradient rim hugging the fragment's corners */
  .float-frag::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.06) 45%, rgba(255, 255, 255, 0.02) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }
  .frag-wide { width: 52%; }
  .frag-modal { width: 24%; }
  .frag-left { left: clamp(0.5rem, 4vw, 4rem); }
  .frag-right { right: clamp(0.5rem, 4vw, 4rem); }

  /* Section headers — left axis, like everything else on the page */
  .section-head {
    margin-bottom: 3rem;
    max-width: 40rem;
  }

  /* Features */
  .features {
    background: var(--surface);
    padding: 7rem 0;
    position: relative;
  }
  .features::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .feature-card { padding: 1.5rem; }
  .feature-card .feature-icon {
    font-size: 1.25rem;
    color: var(--primary-bright);
    margin-bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: var(--primary-tint);
    box-shadow: inset 0 0 0 1px rgba(113, 112, 255, 0.18);
  }
  .feature-card h4 {
    margin-bottom: 0.5rem;
    color: var(--on-surface);
  }
  .feature-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--on-surface-variant);
  }
  @media (max-width: 960px) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .feature-grid { grid-template-columns: 1fr; }
  }

  /* Principles */
  .principles {
    background: var(--surface);
    padding: 7rem 0;
    position: relative;
  }
  .principles::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 4rem;
    max-width: 64rem;
  }
  .principle h4 {
    color: var(--on-surface);
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .principle p {
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 28rem;
    color: var(--on-surface-variant);
  }
  @media (max-width: 720px) {
    .principle-grid { grid-template-columns: 1fr; }
  }

  /* Proof */
  .proof {
    position: relative;
    background: var(--surface);
    padding: 8rem 0;
    overflow: hidden;
    isolation: isolate;
  }
  .proof::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
    z-index: 2;
  }
  .proof-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    margin: 0 auto;
  }
  .proof-ctas {
    margin-top: 2.25rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Install */
  .install {
    background: var(--surface);
    padding: 7rem 0 9rem;
    position: relative;
  }
  .install::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-strong) 50%, transparent);
  }
  .install-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .install-steps li {
    padding: 1.75rem 1.5rem 2rem;
  }
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--primary-tint);
    box-shadow: inset 0 0 0 1px rgba(113, 112, 255, 0.25);
    color: var(--primary-bright);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .install-steps p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--on-surface-variant);
  }
  @media (max-width: 960px) {
    .install-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .install-steps { grid-template-columns: 1fr; }
  }

  /* Responsive */
  @media (max-width: 960px) {
    .hero { padding-top: 4.5rem; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero-stage { margin-top: 3.5rem; }
  }
  @media (max-width: 720px) {
    .view-head {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'copy';
      gap: 0;
      margin-bottom: 2rem;
    }
    .view-head .eyebrow { margin-bottom: 1rem; }
    .view-head h2 { font-size: 2rem; }
    .view-head-copy { padding-top: 1rem; }
    .view-block { padding: 2.5rem 0; }
    .float-frag { display: none; }
    .hero-interactive { display: none; }
    .hero-static { display: block; }
    /* Mobile keeps the soft bottom fade — the static screenshot still
       dissolves into the page there */
    .hero-mockup {
      -webkit-mask-image: linear-gradient(180deg, #000 76%, transparent 100%);
              mask-image: linear-gradient(180deg, #000 76%, transparent 100%);
    }
    h2 { font-size: 1.875rem; }
    .hero-sub { font-size: 1rem; }
    .pitch { padding-top: 5rem; padding-bottom: 5rem; }
    .pitch-statement { font-size: 1.5rem; line-height: 1.35; }
    .features, .principles, .install, .proof { padding: 4rem 0; }
    .views { padding: 3rem 0 1rem; }
  }
</style>

<script>
  // Split the muted tail into words and scrub each one's brighten across the
  // section's scroll-into-view progress, Linear-style.
  const tail = document.querySelector('.pitch-tail')
  if (tail && tail.textContent) {
    const words = tail.textContent.trim().split(/\s+/)
    tail.textContent = ''
    words.forEach((word, i) => {
      const span = document.createElement('span')
      span.className = 'pitch-word'
      span.textContent = word
      // Stagger each word across the cover phase so they light up in sequence.
      const start = 12 + (i / words.length) * 58
      const end = start + (58 / words.length) * 2.4
      span.style.animationRangeStart = `cover ${start}%`
      span.style.animationRangeEnd = `cover ${Math.min(end, 88)}%`
      tail.appendChild(span)
      if (i < words.length - 1) tail.appendChild(document.createTextNode(' '))
    })
  }
</script>
