---
// Site code is registered at https://www.goatcounter.com/.
const code = import.meta.env.PUBLIC_GOATCOUNTER ?? 'obsidian-pm'
const enabled = import.meta.env.PROD && code
---

{enabled && (
  <Fragment>
    <script
      is:inline
      data-goatcounter={`https://${code}.goatcounter.com/count`}
      async
      src="//gc.zgo.at/count.js"
    ></script>
    <script is:inline>
      // Tag any clickable with data-gc-event="name" to count it.
      document.addEventListener('click', (e) => {
        const el = e.target.closest('[data-gc-event]')
        if (!el || !window.goatcounter) return
        const name = el.dataset.gcEvent
        window.goatcounter.count({ path: `event-${name}`, title: name, event: true })
      })
    </script>
  </Fragment>
)}
