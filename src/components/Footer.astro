---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<footer class="site-footer">
  <div class="container-wide footer-inner">
    <div class="brand-line">
      <span class="brand-dot" aria-hidden="true"></span>
      <span>Obsidian Project Manager</span>
    </div>
    <nav class="footer-links">
      <a href={`${base}/docs/install`}>Docs</a>
      <a href="https://github.com/stepankropachev/obsidian-pm" rel="noopener">GitHub</a>
      <a href="https://github.com/stepankropachev/obsidian-pm/blob/main/LICENSE" rel="noopener">License</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-container-low);
    padding: 3rem 0;
    margin-top: 4rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .brand-line {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .brand-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dim) 100%);
  }
  .footer-links {
    display: flex;
    gap: 1.75rem;
  }
  .footer-links a {
    color: var(--on-surface-variant);
    font-size: 0.8125rem;
  }
  .footer-links a:hover {
    color: var(--on-surface);
  }
</style>
