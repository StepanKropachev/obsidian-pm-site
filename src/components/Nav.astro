---
---

<header class="site-nav">
  <div class="container-wide nav-inner">
    <a href="/" class="brand">
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-name">Obsidian Project Manager</span>
      <span class="brand-name-short">Obsidian PM</span>
    </a>
    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="/docs/install">Docs</a>
      <a href="https://github.com/stepankropachev/obsidian-pm" rel="noopener" data-gc-event="nav-github">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 11, 13, 0.5);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
  }
  .site-nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 1.25rem;
    background: linear-gradient(180deg, rgba(10, 11, 13, 0.4), transparent);
    pointer-events: none;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
  }
  .brand:hover { color: var(--on-surface); }
  .brand-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--primary-bright) 0%, var(--primary-dim) 100%);
    box-shadow: 0 0 12px var(--primary), inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    display: inline-block;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .nav-links a {
    color: var(--on-surface-variant);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: color 140ms ease;
  }
  .nav-links a:hover {
    color: var(--on-surface);
  }
  .brand-name-short { display: none; }
  @media (max-width: 540px) {
    .brand-name { display: none; }
    .brand-name-short { display: inline; }
    .nav-links { gap: 1.25rem; }
  }
</style>
