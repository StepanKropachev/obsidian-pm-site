---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<header class="site-nav">
  <div class="container nav-inner">
    <a href={`${base}/`} class="brand">
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-name">Obsidian Project Manager</span>
    </a>
    <nav class="nav-links">
      <a href={`${base}/`}>Home</a>
      <a href={`${base}/docs/install`}>Docs</a>
      <a href="https://github.com/stepankropachev/obsidian-pm" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(248, 249, 251, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--on-surface);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }
  .brand-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dim) 100%);
    display: inline-block;
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  .nav-links a {
    color: var(--on-surface-variant);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .nav-links a:hover {
    color: var(--on-surface);
  }
  @media (max-width: 540px) {
    .brand-name { display: none; }
    .nav-links { gap: 1.25rem; }
  }
</style>
