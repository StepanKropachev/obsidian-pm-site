---
import { docsNav, docsBySlug, docsGroupBySlug } from '../lib/docs-nav'

interface Props {
  currentSlug: string
}

const { currentSlug } = Astro.props
const currentTitle = docsBySlug.get(currentSlug)?.title ?? 'Documentation'
const currentGroup = docsGroupBySlug.get(currentSlug)
---

<aside class="docs-sidebar">
  <button class="sb-toggle" aria-expanded="false" aria-controls="docs-nav" data-gc-event="docs-sidebar-toggle">
    <span class="sb-toggle-label">
      {currentGroup && <span class="sb-toggle-group">{currentGroup}</span>}
      <span class="sb-toggle-current">{currentTitle}</span>
    </span>
    <svg class="sb-toggle-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>
  <nav id="docs-nav">
    {docsNav.map((group) => (
      <div class="sb-group">
        <h4 class="sb-group-title">{group.title}</h4>
        <ul>
          {group.items.map((item) => (
            <li>
              <a
                href={`/docs/${item.slug}`}
                class={item.slug === currentSlug ? 'is-active' : ''}
              >{item.title}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script>
  const sidebar = document.querySelector('.docs-sidebar')
  const toggle = sidebar?.querySelector<HTMLButtonElement>('.sb-toggle')
  toggle?.addEventListener('click', () => {
    const open = sidebar!.classList.toggle('is-open')
    toggle.setAttribute('aria-expanded', String(open))
  })
  // Collapse again after navigating via a link on mobile.
  sidebar?.querySelectorAll('#docs-nav a').forEach((a) =>
    a.addEventListener('click', () => {
      sidebar.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
    })
  )
</script>

<style>
  .docs-sidebar {
    background: var(--surface-container-low);
    padding: 2.5rem 1.25rem 3rem 1.5rem;
    border-radius: var(--radius-lg);
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }
  .sb-toggle {
    display: none;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sb-group-title {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--on-surface-variant);
    margin: 0 0 0.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  li a {
    display: block;
    padding: 0.375rem 0.6rem;
    font-size: 0.8125rem;
    color: var(--on-surface-variant);
    border-radius: var(--radius-sm);
    line-height: 1.4;
  }
  li a:hover {
    background: var(--surface-container);
    color: var(--on-surface);
  }
  li a.is-active {
    background: var(--surface-container-lowest);
    color: var(--on-surface);
    font-weight: 500;
  }
  @media (max-width: 960px) {
    .docs-sidebar {
      position: static;
      max-height: none;
      padding: 0;
      overflow: visible;
    }
    .sb-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      padding: 0.875rem 1.25rem;
      background: none;
      border: none;
      cursor: pointer;
      text-align: left;
      color: var(--on-surface);
      font: inherit;
    }
    .sb-toggle-label {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
    }
    .sb-toggle-group {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--on-surface-variant);
    }
    .sb-toggle-current {
      font-size: 0.9375rem;
      font-weight: 500;
    }
    .sb-toggle-icon {
      flex-shrink: 0;
      color: var(--on-surface-variant);
      transition: transform 0.18s ease;
    }
    .docs-sidebar.is-open .sb-toggle-icon {
      transform: rotate(180deg);
    }
    nav {
      display: none;
      padding: 0.25rem 1.25rem 1.5rem;
    }
    .docs-sidebar.is-open nav {
      display: flex;
    }
  }
</style>
